# Логин и пароль MinIO (хранилище вложений). Рабочий backend/minio.env создаёт:
#   python scripts/init_env.py
# Файл читают два контейнера: minio (это его root-учётка) и backend (как ключи S3).
# Отдельно от backend/.env, чтобы MinIO не видел остальные секреты CRM. Пароль — от 8 символов.
MINIO_ROOT_USER=personalcrm
MINIO_ROOT_PASSWORD=change-me-minio

# Шаблон настроек backend. Рабочий .env с настоящими секретами создаёт:
#   python scripts/init_env.py
# Никогда не коммитьте .env с реальными секретами!

# Строка подключения к MongoDB
# Локально без Docker: mongodb://localhost:27017
# В docker-compose перекрывается на mongodb://mongo:27017
MONGODB_URI=mongodb://localhost:27017

# Имя базы данных
DB_NAME=personalcrm

# Секретный ключ для подписи JWT (обязателен, от 32 символов — иначе backend не стартует). Сгенерировать:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# JWT: время жизни токена в минутах (по умолчанию 1440 = 24 часа)
JWT_EXPIRE_MINUTES=1440

# Первый пользователь. Нужен только при переходе с однопользовательской версии
# и создаётся, только если пароль не короче 8 символов (или задан ADMIN_PASSWORD_HASH):
# при первом запуске он становится обычным пользователем (логин — ADMIN_USERNAME),
# его данные остаются в базе DB_NAME. Дальше пароль меняется в настройках аккаунта,
# новые пользователи регистрируются сами.
ADMIN_USERNAME=admin

# Пароль входа (plaintext — допустимо только локально)
ADMIN_PASSWORD=admin

# Для сервера: задайте bcrypt-хеш и уберите ADMIN_PASSWORD
#   python -c "import bcrypt; print(bcrypt.hashpw(b'your-password', bcrypt.gensalt()).decode())"
# ADMIN_PASSWORD_HASH=$2b$12$...

# Открытая регистрация: true — любой может создать аккаунт (у каждого своя база)
REGISTRATION_OPEN=true

# --- Рейт-лимиты ---
# Redis для счётчиков; в docker-compose задаётся автоматически. Пусто — счётчики в памяти процесса.
# REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_ENABLED=true
# true — брать IP клиента из X-Real-IP. Только если backend стоит за прокси (Caddy),
# который сам выставляет этот заголовок; иначе клиент подделает IP и обойдёт лимиты.
TRUST_PROXY_HEADERS=false

# Шифрование OAuth-токенов в БД (Fernet). Если не задан — выводится из SECRET_KEY (только dev!).
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# TOKEN_ENCRYPTION_KEY=

# Адрес фронтенда (docker compose и npm run dev -- -p 3300). Сюда возвращает браузер после входа
# в Microsoft/Google; он же — CORS origin
FRONTEND_URL=http://localhost:3300

# Публичный адрес backend (для вебхуков Microsoft). Локально вебхуки не приходят.
PUBLIC_BASE_URL=http://localhost:8000

# Интервал фоновой синхронизации, мин. Без вебхуков (локально) — 5, на сервере с вебхуками — 30.
SYNC_INTERVAL_MINUTES=5

# --- Телефон (CardDAV: iPhone / Android через DAVx⁵) ---
# Пароль для телефона каждый пользователь выпускает сам: «Настройки → Аккаунт».
# CARDDAV_PASSWORD — только для перехода с однопользовательской версии: при первом запуске
# он станет паролем телефона первого пользователя, чтобы уже настроенный телефон не отвалился.
# Инструкция: docs/setup_phone.md
# CARDDAV_PASSWORD=

# --- Microsoft (Outlook, календарь, To Do) ---
# Регистрация: https://entra.microsoft.com → App registrations. Инструкция: docs/setup_oauth.md
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
# MS_TENANT=common
# MS_REDIRECT_URI=http://localhost:8000/api/sync/callback/microsoft

# --- Google (Контакты, календарь, Tasks) ---
# Регистрация: https://console.cloud.google.com/apis/credentials. Инструкция: docs/setup_oauth.md
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/sync/callback/google

# --- ИИ-помощник (Sprint 6) ---
# OpenAI-совместимый API. По умолчанию — Ollama на ai-lxc (GTX 1080, 8 ГБ):
# qwen3.5:4b (Q4_K_M, ~3.6 ГБ видеопамяти). Холодная загрузка модели — до минуты;
# чтобы модель не выгружалась, на ai-lxc: OLLAMA_KEEP_ALIVE=30m
LLM_BASE_URL=http://192.168.0.50:11434/v1
LLM_MODEL=qwen3.5:4b
# LLM_API_KEY=
# LLM_REASONING_EFFORT=none
# Запасной провайдер, если локальная модель недоступна (выключен): LLM_FALLBACK=claude
# LLM_FALLBACK=
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
# Очередь: одновременных запросов к модели, задач одного пользователя в очереди, таймаут, хранение результата
# AI_CONCURRENCY=1
# AI_USER_MAX_QUEUED=3
# AI_JOB_TIMEOUT_S=240
# AI_RESULT_TTL_S=21600

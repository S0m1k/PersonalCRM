# Скопируйте этот файл в .env и заполните значения для локальной разработки.
# Никогда не коммитьте .env с реальными секретами!

# Строка подключения к MongoDB
# Локально: mongodb://localhost:27017
# Через docker-compose: mongodb://mongo:27017
MONGODB_URI=mongodb://localhost:27017

# Имя базы данных
DB_NAME=personalcrm

# Секретный ключ для подписи JWT. Сгенерируйте случайную строку:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# JWT: время жизни токена в минутах (по умолчанию 1440 = 24 часа)
JWT_EXPIRE_MINUTES=1440

# Single-user аутентификация
ADMIN_USERNAME=admin

# Для локальной разработки: задайте plaintext пароль
ADMIN_PASSWORD=admin

# Для продакшна: задайте bcrypt-хеш и уберите ADMIN_PASSWORD
# Сгенерировать хеш:
#   python -c "from passlib.context import CryptContext; print(CryptContext(['bcrypt']).hash('your-password'))"
# ADMIN_PASSWORD_HASH=$2b$12$...

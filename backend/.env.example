# Шаблон настроек backend. Рабочий .env с настоящими секретами создаёт:
#   python scripts/init_env.py
# Никогда не коммитьте .env с реальными секретами!

# Строка подключения к MongoDB
# Локально без Docker: mongodb://localhost:27017
# В docker-compose перекрывается на mongodb://mongo:27017
MONGODB_URI=mongodb://localhost:27017

# Имя базы данных
DB_NAME=personalcrm

# Секретный ключ для подписи JWT. Сгенерировать:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# JWT: время жизни токена в минутах (по умолчанию 1440 = 24 часа)
JWT_EXPIRE_MINUTES=1440

# Single-user аутентификация
ADMIN_USERNAME=admin

# Пароль входа (plaintext — допустимо только локально)
ADMIN_PASSWORD=admin

# Для сервера: задайте bcrypt-хеш и уберите ADMIN_PASSWORD
#   python -c "import bcrypt; print(bcrypt.hashpw(b'your-password', bcrypt.gensalt()).decode())"
# ADMIN_PASSWORD_HASH=$2b$12$...

# Шифрование OAuth-токенов в БД (Fernet). Если не задан — выводится из SECRET_KEY (только dev!).
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# TOKEN_ENCRYPTION_KEY=

# Адрес фронтенда (docker compose и npm run dev -- -p 3300). Сюда возвращает браузер после входа
# в Microsoft/Google; он же — CORS origin
FRONTEND_URL=http://localhost:3300

# Публичный адрес backend (для вебхуков Microsoft). Локально вебхуки не приходят.
PUBLIC_BASE_URL=http://localhost:8000

# Интервал фоновой синхронизации, мин. Без вебхуков (локально) — 5, на сервере с вебхуками — 30.
SYNC_INTERVAL_MINUTES=5

# --- Телефон (CardDAV: iPhone / Android через DAVx⁵) ---
# Логин — ADMIN_USERNAME, пароль — этот. Не задан — синхронизация с телефоном выключена.
# Инструкция: docs/setup_phone.md
# CARDDAV_PASSWORD=

# --- Microsoft (Outlook, календарь, To Do) ---
# Регистрация: https://entra.microsoft.com → App registrations. Инструкция: docs/setup_oauth.md
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
# MS_TENANT=common
# MS_REDIRECT_URI=http://localhost:8000/api/sync/callback/microsoft

# --- Google (Контакты, календарь, Tasks) ---
# Регистрация: https://console.cloud.google.com/apis/credentials. Инструкция: docs/setup_oauth.md
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/sync/callback/google
